# Public Sites runtime values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Non-secret Cloudflare resource identifiers.
CF_ACCOUNT_ID=
CF_ZONE_ID=
CF_ZONE_NAME=
CF_ACCESS_TEAM_NAME=
CF_ACCESS_SERVICE_TOKEN_ID=
CF_ACCESS_CLIENT_ID=

# Sites secrets. The API token needs only Tunnel, DNS, and Access app/policy
# permissions for the account and zone above.
CF_TUNNEL_API_TOKEN=
# This credential must belong to CF_ACCESS_SERVICE_TOKEN_ID.
CF_ACCESS_CLIENT_SECRET=
